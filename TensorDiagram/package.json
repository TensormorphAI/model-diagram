    "eslint-plugin-import-x": "~4.18.1",
    "eslint-plugin-n": "~18.6.0",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-storybook": "~10.6.9",
    "eslint-plugin-unicorn": "~80.0.0",
    "globals": "~17.14.0",
    "prettier": "~3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.74.0"
